# Database connection string:
# Neon PostgreSQL (Cloud):
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or Local Docker Postgres:
DATABASE_URL=postgres://pp360:pp360@localhost:5433/peoplepay360

PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
SEED_PASSWORD=Password123!
# Optional SMTP for real payslip email. Leave blank to log to console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=genaihthon@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="PeoplePay360 Payroll <genaihthon@gmail.com>"
# Safe Catch-All: Redirects all employee payslip emails to one address (prevents bounces)
MAIL_REDIRECT_TO=genaihthon@gmail.com
